LLM_MODEL=claude-haiku-5-5
ANTHROPIC_API_KEY=your-anthropic-api-key
# claude-haiku-5-5 is the fastest fit for Alexa's ~8s response limit.
# claude-sonnet-5-5 also works (thinking set to "between_tools" in agent.py).
TAVILY_API_KEY=your-tavily-api-key
# Only for a self-managed Lambda; Alexa-hosted skills use their own bucket.
S3_BUCKET_NAME=jarvis-wiki
